# Serves the SPA and proxies /api to the backend. Rendered at container start by the nginx image
# (envsubst): API_UPSTREAM = host:port of the API (compose: api:8000, Helm: the service's full DNS name,
# because nginx's resolver ignores DNS search domains).
# The upstream is a variable + resolver so a restarted/recreated API container is found again
# (a literal proxy_pass host is resolved once at startup and goes stale).
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

server {
    listen 8080;
    server_name _;
    # HTTPS listener + HTTP->HTTPS redirect when a certificate is mounted (written by docker-tls.sh).
    include /tmp/infra-ops-tls.conf;
    set $api_upstream http://${API_UPSTREAM};
    root /usr/share/nginx/html;
    client_max_body_size 25m;

    include /etc/nginx/security-headers.conf;

    location /api/ {
        proxy_pass $api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/security-headers.conf;
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        include /etc/nginx/security-headers.conf;
        try_files $uri /index.html;
    }
}
