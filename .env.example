# Copy to .env. Never commit the real .env.
INFRAOPS_ENVIRONMENT=production
INFRAOPS_PUBLIC_BASE_URL=https://infraops.congty.local

# Generate with: docker compose run --rm api python -m app.cli generate-master-key
# Rotation: prepend a new key ("v2:...,v1:..."); the first key encrypts, all keys decrypt.
INFRAOPS_MASTER_KEYS=
# At least 32 random characters (signs SSO state cookies).
INFRAOPS_SIGNING_SECRET=

# local = username/password accounts in the app (until Entra SSO is configured); oidc = Microsoft Entra ID
INFRAOPS_AUTH_MODE=local
INFRAOPS_OIDC_TENANT_ID=
INFRAOPS_OIDC_CLIENT_ID=
INFRAOPS_OIDC_CLIENT_SECRET=
# Comma-separated UPNs granted the Admin role at sign-in (SSO bootstrap).
INFRAOPS_BOOTSTRAP_ADMIN_UPNS=

INFRAOPS_ENABLED_MODULES=lifecycle,workload
INFRAOPS_SECRET_EXPIRY_WARN_DAYS=30
POSTGRES_PASSWORD=change-me
